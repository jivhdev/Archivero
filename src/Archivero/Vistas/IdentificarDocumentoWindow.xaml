<Window x:Class="Archivero.Vistas.IdentificarDocumentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Archivero.Vistas"
        Title="Archivero — Identificar documento"
        Height="720" Width="1080"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <local:VisorPdfConMarcado x:Name="Visor" Grid.Column="0" Margin="0,0,16,0"/>

        <StackPanel Grid.Column="1">
            <TextBlock Name="TxtTituloPaso" FontSize="15" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBlock Name="TxtInstruccionPaso" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- Paso 1: Emisor y Tipo -->
            <StackPanel Name="PanelEmisorTipo">
                <TextBlock Text="Emisor" FontWeight="Bold"/>
                <Button Name="BtnMarcarEmisor" Content="Marcar Emisor en el PDF" Margin="0,4,0,4" Padding="6,4" Click="BtnMarcarEmisor_Click"/>
                <TextBlock Name="TxtEstadoMarcaEmisor" Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <ComboBox Name="CmbEmisor" IsEditable="True" Margin="0,0,0,16" TextBoxBase.TextChanged="CmbEmisor_TextChanged"/>

                <TextBlock Text="Tipo de documento" FontWeight="Bold"/>
                <Button Name="BtnMarcarTipo" Content="Marcar Tipo en el PDF" Margin="0,4,0,4" Padding="6,4" Click="BtnMarcarTipo_Click"/>
                <TextBlock Name="TxtEstadoMarcaTipo" Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <ComboBox Name="CmbTipo" IsEditable="True" TextBoxBase.TextChanged="CmbTipo_TextChanged"/>
            </StackPanel>

            <!-- Paso 2: Carpeta destino -->
            <StackPanel Name="PanelCarpeta" Visibility="Collapsed">
                <TextBlock Text="Carpeta de destino" FontWeight="Bold"/>
                <TextBox Name="TxtCarpetaDestino" IsReadOnly="True" Margin="0,8,0,8"/>
                <Button Name="BtnElegirCarpeta" Content="Elegir carpeta…" Padding="6,4" HorizontalAlignment="Left" Click="BtnElegirCarpeta_Click"/>
            </StackPanel>

            <!-- Paso 3: Formato y patron de carpeta -->
            <StackPanel Name="PanelFormato" Visibility="Collapsed">
                <TextBlock Text="¿Cómo se organizan las subcarpetas?" FontWeight="Bold" Margin="0,0,0,8"/>
                <RadioButton Name="RbDirecto" Content="Directo en la carpeta (sin subcarpetas)" Margin="0,0,0,6" Checked="OpcionFormato_Changed"/>
                <RadioButton Name="RbAnio" Content="Por año" Margin="0,0,0,6" Checked="OpcionFormato_Changed"/>
                <RadioButton Name="RbAnioMes" Content="Por año y mes" Margin="0,0,0,6" Checked="OpcionFormato_Changed"/>

                <StackPanel Name="PanelPatronCarpeta" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="Patrón de la subcarpeta (ej. yyyy o yyyy\MM):"/>
                    <ComboBox Name="CmbPatronCarpeta" IsEditable="True" Margin="0,4,0,12"/>
                </StackPanel>

                <StackPanel Name="PanelMarcarFecha" Visibility="Collapsed">
                    <TextBlock Text="Fecha del documento" FontWeight="Bold"/>
                    <Button Name="BtnMarcarFecha" Content="Marcar fecha en el PDF" Margin="0,4,0,4" Padding="6,4" Click="BtnMarcarFecha_Click"/>
                    <TextBlock Name="TxtEstadoMarcaFecha" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Paso 4: Nombre de archivo -->
            <StackPanel Name="PanelNombreArchivo" Visibility="Collapsed">
                <TextBlock Text="Nombre con el que se guarda el archivo" FontWeight="Bold" Margin="0,0,0,8"/>
                <RadioButton Name="RbMantenerNombre" Content="Mantener el nombre original" Margin="0,0,0,6" Checked="OpcionNombre_Changed"/>
                <RadioButton Name="RbExtraerNombre" Content="Extraer de una coordenada del PDF" Margin="0,0,0,6" Checked="OpcionNombre_Changed"/>

                <StackPanel Name="PanelMarcarNombre" Visibility="Collapsed" Margin="0,8,0,0">
                    <Button Name="BtnMarcarNombreArchivo" Content="Marcar el campo en el PDF" Margin="0,0,0,4" Padding="6,4" Click="BtnMarcarNombreArchivo_Click"/>
                    <TextBlock Name="TxtEstadoMarcaNombre" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Paso 5: Confirmar -->
            <StackPanel Name="PanelConfirmar" Visibility="Collapsed">
                <TextBlock Name="TxtResumen" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Name="TxtError" Foreground="Red" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Name="BtnPosponer" Content="Posponer" Width="100" Margin="0,0,8,0" Padding="6,6" Click="BtnPosponer_Click"/>
            <Button Name="BtnCancelar" Content="Cancelar" Width="100" Margin="0,0,8,0" Padding="6,6" Click="BtnCancelar_Click"/>
            <Button Name="BtnSiguiente" Content="Siguiente" Width="150" Padding="6,6" IsDefault="True" Click="BtnSiguiente_Click"/>
        </StackPanel>
    </Grid>
</Window>
