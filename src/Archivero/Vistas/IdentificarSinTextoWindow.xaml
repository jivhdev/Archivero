<Window x:Class="Archivero.Vistas.IdentificarSinTextoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archivero — Documento sin texto extraíble"
        Height="640" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,16,0" BorderBrush="Gray" BorderThickness="1">
            <Image Name="ImagenDocumento" Stretch="Uniform"/>
        </Border>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Este documento no tiene texto que se pueda leer" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="No se puede marcar ningún dato por coordenadas (ej. es una imagen escaneada). Escribí el Emisor y el Tipo a mano; los próximos documentos de este mismo tipo se van a guardar solos en la misma carpeta (sin poder renombrarlos, porque no hay texto para extraer)."
                        Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="Emisor" FontWeight="Bold"/>
            <ComboBox Name="CmbEmisor" IsEditable="True" Margin="0,4,0,12" TextBoxBase.TextChanged="CmbEmisor_TextChanged"/>

            <TextBlock Text="Tipo de documento" FontWeight="Bold"/>
            <ComboBox Name="CmbTipo" IsEditable="True" Margin="0,4,0,12" TextBoxBase.TextChanged="CmbTipo_TextChanged"/>

            <TextBlock Text="Carpeta de destino" FontWeight="Bold"/>
            <TextBox Name="TxtCarpetaDestino" IsReadOnly="True" Margin="0,4,0,8"/>
            <Button Name="BtnElegirCarpeta" Content="Elegir carpeta…" Padding="6,4" HorizontalAlignment="Left" Click="BtnElegirCarpeta_Click"/>

            <TextBlock Name="TxtError" Foreground="Red" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="100" Margin="0,0,8,0" Padding="6,6" Click="BtnCancelar_Click"/>
            <Button Content="Guardar y clasificar" Width="160" Padding="6,6" IsDefault="True" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
