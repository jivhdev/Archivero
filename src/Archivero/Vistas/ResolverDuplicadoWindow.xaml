<Window x:Class="Archivero.Vistas.ResolverDuplicadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archivero — Documento duplicado"
        Height="560" Width="780"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" Text="Ya existe un archivo con este nombre en el destino" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Name="TxtRutaConflicto" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"/>

        <Grid Grid.Row="2" Name="PanelComparacion" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Ya guardado" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <Border BorderBrush="Gray" BorderThickness="1">
                    <Image Name="ImagenExistente" Stretch="Uniform"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Documento nuevo" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <Border BorderBrush="Gray" BorderThickness="1">
                    <Image Name="ImagenNuevo" Stretch="Uniform"/>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Name="BtnRevisar" Content="Revisar lado a lado" Padding="8,6" Margin="0,0,8,0" Click="BtnRevisar_Click"/>
            <Button Content="Reemplazar" Padding="8,6" Margin="0,0,8,0" Click="BtnReemplazar_Click"/>
            <Button Content="Dejar pendiente" Padding="8,6" Margin="0,0,8,0" Click="BtnDejarPendiente_Click"/>
            <Button Content="Guardar en otra ubicación" Padding="8,6" Click="BtnExcepcion_Click"/>
        </StackPanel>
    </Grid>
</Window>
