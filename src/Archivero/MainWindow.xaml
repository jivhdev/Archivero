        Title="Archivero" Height="300" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="16" FontWeight="Bold" Text="Archivero" Margin="0,0,0,12"/>
            <TextBlock Name="TxtCarpetaObservada" TextWrapping="Wrap"/>
